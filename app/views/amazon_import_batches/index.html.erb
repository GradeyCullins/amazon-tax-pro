<div class="page-header">
  <div>
    <h1>Sync history</h1>
    <p class="muted">Every Amazon sync, plus any reports you uploaded. Their rows all show up on Review under the tax year they belong to.</p>
  </div>
  <div class="actions">
    <%= render "amazon_syncs/sync_action", year: current_tax_year %>
  </div>
</div>

<div class="card">
  <% if @batches.empty? %>
    <div class="empty-state">
      <h2>Nothing synced yet</h2>
      <p class="guide-copy">Connect Amazon and sync a tax year from the dashboard. Each sync shows up here with what it added.</p>
      <div class="actions">
        <%= link_to "Go to dashboard", root_path, class: "button" %>
      </div>
    </div>
  <% else %>
    <table class="tight">
      <thead>
        <tr>
          <th scope="col">Sync</th>
          <th scope="col">Source</th>
          <th scope="col">Tax year</th>
          <th scope="col">Started</th>
          <th scope="col">Status</th>
          <th scope="col">Rows added</th>
          <th scope="col">Needs review</th>
        </tr>
      </thead>
      <tbody>
        <% @batches.each do |batch| %>
          <% needs_review_count = @needs_review_counts.fetch(batch.id, 0) %>
          <tr>
            <td><%= link_to batch.display_name, amazon_import_batch_path(batch) %></td>
            <td><span class="pill"><%= batch.source_label %></span></td>
            <td><%= batch.source_sp_api? ? batch.tax_year : @upload_years.fetch(batch.id, []).join(", ").presence || "No dates" %></td>
            <td><%= l(batch.created_at, format: :short) %></td>
            <td><%= sync_pill(batch) %></td>
            <td><%= number_with_delimiter(batch.row_count) %></td>
            <td><%= needs_review_count.zero? ? "None" : review_pill("needs_review", number_with_delimiter(needs_review_count)) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>

<p class="note">Can't connect Amazon? <%= link_to "Upload a Seller Central report", new_amazon_import_batch_path %> instead.</p>
