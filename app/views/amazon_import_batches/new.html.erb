<div class="page-header">
  <div>
    <h1>Upload a Seller Central report</h1>
    <p class="muted">The fallback for sellers who can't connect Amazon. Uploaded rows are categorized the same way as synced ones.</p>
  </div>
  <div class="actions">
    <%= link_to "Sync history", amazon_import_batches_path, class: "button secondary" %>
  </div>
</div>

<% if amazon_connect_available? %>
  <div class="callout warn">
    <p><strong>Most sellers should connect Amazon instead.</strong> Syncing pulls in a full tax year for you, with no reports to find or download.</p>
    <div class="actions">
      <%= render "amazon_syncs/sync_action", year: current_tax_year %>
    </div>
  </div>
<% end %>

<div class="grid dashboard-main">
  <div class="card">
    <h2>Upload your report</h2>
    <p class="guide-copy">Use a settlement report or the 2025 transaction report from Seller Central. CSV, TSV, and TXT files work. Keep the original column headers.</p>
    <%= form_with url: amazon_import_batches_path, multipart: true, class: "section" do |form| %>
      <div class="form-row">
        <%= form.label :file, "Seller Central report" %>
        <%= form.file_field :file, accept: ".csv,.tsv,.txt,text/csv,text/tab-separated-values" %>
      </div>
      <%= form.submit "Upload report", class: "button" %>
    <% end %>
    <% if @synced_years.any? %>
      <p class="note">Rows from <%= @synced_years.sort.to_sentence %> are skipped because you've synced <%= @synced_years.one? ? "that year" : "those years" %> from Amazon. Synced data replaces uploads so nothing is counted twice.</p>
    <% end %>
  </div>

  <div class="card guide-card">
    <h2>When to upload</h2>
    <ul class="guide-list">
      <li>Your account is on the Individual selling plan. Amazon only lets Professional sellers connect apps.</li>
      <li>You aren't the account's primary user, and the primary user can't connect it for you.</li>
      <li>Connecting Amazon isn't available right now.</li>
    </ul>
  </div>
</div>
