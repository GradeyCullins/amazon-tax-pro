<% if @batch.sync_active? %>
  <% content_for :head do %><meta http-equiv="refresh" content="5"><% end %>
<% end %>

<div class="page-header">
  <div>
    <h1><%= @batch.display_name %></h1>
    <p class="muted"><%= @batch.source_label %> · started <%= l(@batch.created_at, format: :short) %> · <%= pluralize(number_with_delimiter(@batch.row_count), "row") %> added · <%= @batch.status_label %></p>
  </div>
  <div class="actions">
    <%= link_to "Sync history", amazon_import_batches_path, class: "button secondary" %>
  </div>
</div>

<% if @batch.source_sp_api? %>
  <div class="card connect-card">
    <h2>Amazon sync · <%= @batch.tax_year %></h2>
    <% if @batch.sandbox_sample? %>
      <p class="guide-copy">Sandbox sample data keeps Amazon's fixed dates, whatever tax year you sync. Re-syncing skips sample rows you already have.</p>
    <% end %>
    <div class="connect-meta">
      <%= sync_pill(@batch) %>
      <span class="pill"><%= pluralize(number_with_delimiter(@batch.transactions_fetched.to_i), "transaction") %> fetched</span>
      <span class="pill"><%= pluralize(number_with_delimiter(@batch.row_count), "new row") %></span>
      <% if @batch.finished_at %>
        <span class="pill">Finished <%= l(@batch.finished_at, format: :short) %></span>
      <% end %>
    </div>
    <% if @batch.sync_active? %>
      <p class="guide-copy">Pulling transactions from Amazon. Amazon limits how fast data can be requested, so a full year can take a few minutes. This page refreshes on its own.</p>
    <% elsif @batch.sync_failed? %>
      <div class="callout"><p><%= @batch.error_message %></p></div>
      <p class="guide-copy">Rows added before the error are kept. Fix the problem and sync again; transactions you already have are skipped.</p>
      <div class="actions">
        <%= render "amazon_syncs/sync_action", year: @batch.tax_year %>
      </div>
    <% elsif @batch.row_count.zero? %>
      <p class="guide-copy">No new transactions. An earlier sync may already have everything for <%= @batch.tax_year %>.</p>
    <% end %>
  </div>
<% end %>

<div class="card section">
  <h2>What this <%= @batch.source_sp_api? ? "sync" : "upload" %> added</h2>
  <% if @year_summaries.empty? && @undated_count.zero? %>
    <p class="guide-copy"><%= @batch.sync_active? ? "Nothing yet. Rows show up here as the sync finds them." : "No rows were added." %></p>
  <% else %>
    <table class="tight">
      <thead>
        <tr>
          <th scope="col">Tax year</th>
          <th scope="col">Rows</th>
          <th scope="col">Needs review</th>
          <th scope="col">Counted</th>
          <th scope="col">Skipped</th>
          <th scope="col"></th>
        </tr>
      </thead>
      <tbody>
        <% @year_summaries.each do |year, counts| %>
          <tr>
            <th scope="row"><%= year %></th>
            <td><%= number_with_delimiter(counts.values.sum) %></td>
            <td><%= counts.fetch("needs_review").zero? ? "None" : review_pill("needs_review", number_with_delimiter(counts.fetch("needs_review"))) %></td>
            <td><%= number_with_delimiter(counts.fetch("auto_accepted") + counts.fetch("user_accepted")) %></td>
            <td><%= number_with_delimiter(counts.fetch("skipped")) %></td>
            <td><%= link_to "Review #{year}", review_path(year: year, import_id: @batch.id, status: (counts.fetch("needs_review").zero? ? "all" : nil)) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @undated_count.positive? %>
      <p class="note"><%= pluralize(number_with_delimiter(@undated_count), "row") %> had no date we could read, so <%= @undated_count == 1 ? "it doesn't" : "they don't" %> count toward any tax year.</p>
    <% end %>
  <% end %>
</div>

<% if @batch.source_upload? %>
  <div class="card section">
    <h2>Delete this upload</h2>
    <p class="guide-copy">Removes the upload and its <%= pluralize(number_with_delimiter(@batch.row_count), "row") %> from Review and your totals. Synced rows aren't affected.</p>
    <div class="actions">
      <%= button_to "Delete this upload", amazon_import_batch_path(@batch), method: :delete, class: "button danger",
            form: { onsubmit: "return confirm('Delete this upload and its rows? This cannot be undone.')" } %>
    </div>
  </div>
<% end %>
