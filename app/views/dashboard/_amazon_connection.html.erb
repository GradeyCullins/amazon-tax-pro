<%# locals: (connection:, active_sync:, year_status:) -%>
<% year = year_status.year %>
<div class="card connect-card">
  <% if sandbox_seller? %>
    <div class="callout"><p><strong>Sandbox sample data.</strong> Syncs use generated transactions for <%= SandboxSeller::BUSINESS_NAME %>, not Amazon.</p></div>
  <% elsif AmazonSpApi.sandbox? %>
    <div class="callout"><p>Development uses Amazon's sandbox and mock transactions. Each sync fetches the same sample data, whatever tax year you pick. Rows keep Amazon's sample dates, so switch to that year to review them.</p></div>
  <% end %>

  <% if !amazon_connect_available? %>
    <div class="connect-header">
      <h2>Amazon connection unavailable</h2>
      <div class="actions">
        <%= link_to "Upload a report", new_amazon_import_batch_path, class: "button" %>
      </div>
    </div>
    <p class="guide-copy">Connecting Amazon isn't available right now. You can upload a Seller Central report in the meantime.</p>
  <% elsif connection.nil? %>
    <div class="connect-header">
      <div>
        <h2>Connect your Amazon seller account</h2>
        <div class="connect-meta">
          <span class="pill">US marketplace</span>
          <span class="pill">Read-only financial data</span>
          <span class="pill">Professional selling plan</span>
        </div>
      </div>
      <div class="actions">
        <%= link_to "Connect Amazon", new_amazon_connection_path, class: "button" %>
      </div>
    </div>
    <p class="guide-copy">Approve read-only access to your financial transactions in Seller Central. We sync a full tax year of sales, refunds, and fees and categorize them for you, with no reports to download.</p>
    <div class="connect-footer">
      <p class="note">The seller account's primary user has to approve the connection. Can't connect? <%= link_to "Upload a report instead", new_amazon_import_batch_path %>.</p>
    </div>
  <% elsif !connection.active? %>
    <div class="connect-header">
      <div>
        <h2>Reconnect Amazon</h2>
        <div class="connect-meta">
          <span class="pill bad">Needs reconnect</span>
          <span class="pill">Seller <%= connection.selling_partner_id %></span>
        </div>
      </div>
      <div class="actions">
        <%= link_to "Reconnect Amazon", new_amazon_connection_path, class: "button" %>
      </div>
    </div>
    <% if connection.last_error.present? %>
      <div class="callout"><p><%= connection.last_error %></p></div>
    <% end %>
    <p class="guide-copy">Amazon stopped accepting our access. Reconnect to keep syncing; rows you already synced stay.</p>
  <% elsif active_sync %>
    <div class="connect-header">
      <div>
        <h2>Syncing <%= active_sync.tax_year %> from Amazon</h2>
        <div class="connect-meta">
          <%= sync_pill(active_sync) %>
          <span class="pill"><%= pluralize(number_with_delimiter(active_sync.transactions_fetched.to_i), "transaction") %> fetched</span>
          <span class="pill"><%= pluralize(number_with_delimiter(active_sync.row_count), "new row") %></span>
        </div>
      </div>
      <div class="actions">
        <%= link_to "View sync details", amazon_import_batch_path(active_sync), class: "button secondary" %>
      </div>
    </div>
    <p class="guide-copy">Amazon limits how fast data can be requested, so a full year can take a few minutes. This page refreshes on its own, and it's fine to leave it.</p>
  <% else %>
    <div class="connect-header">
      <div>
        <h2>Amazon seller account</h2>
        <div class="connect-meta">
          <span class="pill good">Connected</span>
          <span class="pill">Seller <%= connection.selling_partner_id %></span>
          <% if (latest_sync = year_status.latest_sync) %>
            <span class="note">Last <%= year %> sync <%= link_to local_time(latest_sync.finished_at || latest_sync.created_at), amazon_import_batch_path(latest_sync) %></span>
            <%= sync_pill(latest_sync) %>
          <% else %>
            <span class="note">You haven't synced <%= year %> yet.</span>
          <% end %>
        </div>
      </div>
      <div class="actions">
        <%= link_to "Sync history", amazon_import_batches_path, class: "button secondary" %>
        <%= render "amazon_syncs/sync_action", year: year %>
      </div>
    </div>
    <% if connection.last_error.present? %>
      <div class="callout"><p><%= connection.last_error %></p></div>
    <% end %>
  <% end %>

  <% if connection %>
    <% if connection.active? && !active_sync %>
      <details class="connect-details">
        <summary>Sync and connection details</summary>
        <div class="connect-details-body">
          <p class="note">A sync pulls released transactions for the calendar year (Pacific time). Amazon can lag up to 48 hours. Re-syncing adds new rows and keeps your reviews.<% if sandbox_seller? %> Sample data is separate for each year.<% end %></p>
          <%= button_to "Disconnect Amazon", amazon_connection_path, method: :delete, class: "button small secondary",
                form: { onsubmit: "return confirm('Disconnect Amazon? Rows you already synced stay, but we delete the stored authorization.')" } %>
        </div>
      </details>
    <% else %>
      <div class="connect-footer">
        <p class="note">Disconnecting deletes the stored authorization. Rows you already synced stay.</p>
        <%= button_to "Disconnect Amazon", amazon_connection_path, method: :delete, class: "button small secondary",
              form: { onsubmit: "return confirm('Disconnect Amazon? Rows you already synced stay, but we delete the stored authorization.')" } %>
      </div>
    <% end %>
  <% end %>
</div>
