<section class="card section outside-reminder" aria-label="Outside Amazon expenses">
  <div>
    <h2>Outside Amazon expenses</h2>
    <div class="value"><%= money(@outside_expense_total_cents) %></div>
    <p class="note"><% if @outside_expense_count.positive? %><%= pluralize(@outside_expense_count, "expense") %> entered for <%= year %>.<% else %>Nothing entered for <%= year %> yet. Add business costs paid outside Amazon if you had any.<% end %></p>
  </div>
  <%= link_to @outside_expense_count.positive? ? "Add or edit expenses" : "Add an expense", outside_expenses_path(year: year), class: "button secondary" %>
</section>
