<!DOCTYPE html>
<html>
  <head>
    <title>Amazon Tax Pro</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="icon" type="image/png" href="/favicon.png">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <style>
      :root {
        --ink:#131921;
        --paper:#f3f3f3;
        --surface:#ffffff;
        --surface-soft:#f7f7f7;
        --surface-muted:#e3e6e6;
        --border:#131921;
        --primary:#ff9900;
        --primary-dark:#e47911;
        --muted:#565959;
        --shadow:7px 7px 0 var(--ink);
        --small-shadow:4px 4px 0 var(--ink);
      }

      * { box-sizing:border-box; }
      html { background:var(--paper); }
      body {
        background:
          linear-gradient(90deg, rgba(19,25,33,.045) 1px, transparent 1px),
          linear-gradient(rgba(19,25,33,.045) 1px, transparent 1px),
          var(--paper);
        background-size:34px 34px;
        color:var(--ink);
        font-family:ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-size:16px;
        font-weight:650;
        margin:0;
        overflow-x:hidden;
      }
      body::before {
        background:var(--primary);
        content:"";
        display:block;
        height:8px;
      }
      .shell { max-width:1240px; margin:0 auto; padding:24px; width:100%; }
      .nav {
        align-items:center;
        background:var(--surface);
        border:4px solid var(--border);
        box-shadow:var(--shadow);
        display:flex;
        gap:10px;
        margin-bottom:34px;
        padding:12px;
        transform:rotate(-.35deg);
        flex-wrap:wrap;
      }
      .nav a {
        background:var(--surface-soft);
        border:3px solid var(--border);
        border-radius:999px;
        color:var(--ink);
        display:inline-flex;
        font-weight:950;
        min-height:42px;
        align-items:center;
        justify-content:center;
        padding:8px 14px;
        text-decoration:none;
        transition:transform .12s ease, box-shadow .12s ease, background .12s ease;
      }
      .nav a:first-child {
        background:var(--ink);
        color:#fff;
        font-size:20px;
        padding-inline:18px;
      }
      .nav a:nth-child(2) { background:var(--surface-muted); }
      .nav a:nth-child(3) { background:var(--surface); }
      .nav a:nth-child(4) { background:var(--primary); color:var(--ink); }
      .nav a:hover, .button:hover {
        box-shadow:var(--small-shadow);
        transform:translate(-2px, -2px) rotate(-1deg);
      }
      h1 {
        color:var(--ink);
        font-family:ui-serif, Georgia, "Times New Roman", serif;
        font-size:clamp(44px, 10vw, 86px);
        font-weight:1000;
        line-height:.95;
        margin:0 0 16px;
        max-width:900px;
        overflow-wrap:anywhere;
      }
      h2 {
        font-family:ui-serif, Georgia, "Times New Roman", serif;
        font-size:clamp(25px, 4vw, 38px);
        font-weight:1000;
        line-height:.95;
        margin-bottom:14px;
      }
      p { line-height:1.45; }
      a { color:var(--primary); font-weight:950; text-decoration-thickness:3px; text-underline-offset:4px; }
      .page-header {
        align-items:flex-start;
        display:flex;
        gap:20px;
        justify-content:space-between;
        margin-bottom:24px;
      }
      .page-header .muted {
        color:var(--ink);
        font-size:15px;
        max-width:680px;
        text-transform:none;
      }
      .actions { display:flex; gap:10px; flex-wrap:wrap; }
      .grid { display:grid; gap:18px; }
      .cards { grid-template-columns: repeat(auto-fit,minmax(200px,1fr)); }
      .dashboard-main { grid-template-columns:minmax(0,2fr) minmax(260px,1fr); margin-top:18px; }
      .guide-grid { grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); margin-bottom:18px; }
      .card {
        background:var(--surface);
        border:4px solid var(--border);
        border-radius:8px;
        box-shadow:var(--shadow);
        min-width:0;
        overflow-x:auto;
        padding:18px;
      }
      .cards > .card:nth-child(4n+1) { background:var(--surface); transform:rotate(-.4deg); }
      .cards > .card:nth-child(4n+2) { background:var(--surface-soft); transform:rotate(.5deg); }
      .cards > .card:nth-child(4n+3) { background:var(--surface-muted); transform:rotate(-.2deg); }
      .cards > .card:nth-child(4n+4) { background:#f3f4f6; transform:rotate(.3deg); }
      turbo-frame.card { display:block; }
      .button {
        appearance:none;
        background:var(--primary);
        border:4px solid var(--border);
        border-radius:999px;
        box-shadow:var(--small-shadow);
        color:var(--ink);
        display:inline-flex;
        align-items:center;
        justify-content:center;
        font:inherit;
        font-weight:1000;
        min-height:46px;
        padding:9px 16px;
        text-align:center;
        text-decoration:none;
        transition:transform .12s ease, box-shadow .12s ease, background .12s ease;
      }
      .button:hover { background:var(--primary-dark); }
      .button.secondary { background:var(--surface); color:var(--ink); }
      .button.secondary:hover { background:var(--surface-muted); }
      .button.small { min-height:38px; padding:6px 12px; font-size:14px; }
      .flash {
        background:var(--surface-muted);
        border:4px solid var(--border);
        box-shadow:var(--small-shadow);
        margin-bottom:20px;
        padding:12px 14px;
        font-weight:950;
      }
      .flash.alert { background:#d1d5db; color:var(--ink); }
      .guide-card h2,
      .guide-card h3 {
        margin-top:0;
      }
      .guide-card h3 {
        font-family:ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-size:19px;
        line-height:1.1;
        margin-bottom:8px;
      }
      .guide-step {
        align-items:center;
        background:var(--ink);
        border:3px solid var(--border);
        border-radius:999px;
        color:#fff;
        display:inline-flex;
        font-family:ui-serif, Georgia, "Times New Roman", serif;
        font-size:28px;
        font-weight:1000;
        height:48px;
        justify-content:center;
        margin-bottom:12px;
        width:48px;
      }
      .guide-copy {
        color:var(--ink);
        font-size:15px;
        font-weight:750;
        line-height:1.45;
        margin:0;
      }
      .guide-list {
        display:grid;
        gap:10px;
        list-style:none;
        margin:0;
        padding:0;
      }
      .guide-list li {
        background:var(--surface-soft);
        border:3px solid var(--border);
        border-radius:6px;
        margin:0;
        padding:10px 12px;
      }
      .callout {
        background:var(--surface-muted);
        border:4px solid var(--border);
        box-shadow:var(--small-shadow);
        margin:18px 0;
        padding:14px 16px;
      }
      .callout p { margin:0; }
      .form-row { display:grid; gap:7px; margin-bottom:14px; max-width:520px; width:100%; }
      .inline-form { display:flex; gap:10px; align-items:center; flex-wrap:wrap; }
      label { font-weight:950; }
      input, select {
        background:var(--surface);
        border:3px solid var(--border);
        border-radius:6px;
        box-shadow:3px 3px 0 rgba(17,24,39,.2);
        color:var(--ink);
        font:inherit;
        max-width:100%;
        min-height:42px;
        padding:8px 10px;
      }
      input:focus, select:focus {
        outline:4px solid var(--primary);
        outline-offset:2px;
      }
      input[type="file"] { width:100%; }
      .muted {
        color:var(--muted);
        font-size:12px;
        font-weight:950;
        letter-spacing:0;
        text-transform:uppercase;
      }
      .value {
        color:var(--primary);
        font-family:ui-serif, Georgia, "Times New Roman", serif;
        font-size:clamp(28px, 7vw, 42px);
        font-weight:1000;
        line-height:.95;
        margin-top:8px;
        overflow-wrap:anywhere;
      }
      .tight {
        border-collapse:separate;
        border-spacing:0;
        width:100%;
        font-size:14px;
      }
      .tight td,.tight th {
        border-bottom:3px solid var(--ink);
        padding:12px 10px;
        text-align:left;
        vertical-align:top;
      }
      .tight th {
        background:var(--ink);
        color:#fff;
        font-weight:1000;
      }
      .tight tr:nth-child(even) td { background:var(--surface-soft); }
      .tight tr:hover td { background:var(--surface-muted); }
      .bars { display:grid; gap:12px; }
      .bar { align-items:center; display:grid; gap:8px; grid-template-columns:minmax(110px, 1fr) minmax(90px, 2fr); }
      .bar span:first-child { min-width:0; overflow-wrap:anywhere; }
      .bar span:last-child {
        background:linear-gradient(90deg, var(--ink), var(--surface-muted));
        border:3px solid var(--border);
        display:inline-block;
        height:18px;
        min-width:18px;
      }
      ul, ol { padding-left:24px; }
      li { margin-bottom:8px; }

      @media (max-width: 720px) {
        .shell { padding:16px; }
        .nav { align-items:stretch; gap:8px; transform:none; }
        .nav a { flex:1 1 150px; padding:8px; text-align:center; }
        .page-header { display:grid; }
        .actions, .page-header > .button { width:100%; }
        .actions .button, .page-header > .button { flex:1 1 160px; }
        .dashboard-main { grid-template-columns:1fr; }
        .guide-grid { grid-template-columns:1fr; }
        .card { padding:14px; }
        .tight { min-width:640px; }
        .inline-form { align-items:stretch; }
        .inline-form select, .inline-form input, .inline-form .button { flex:1 1 140px; }
      }

      @media (max-width: 460px) {
        .cards { grid-template-columns:1fr; }
        .button { width:100%; }
      }
    </style>
  </head>

  <body>
    <main class="shell">
      <nav class="nav">
        <%= link_to "Amazon Tax Pro", root_path %>
        <%= link_to "Imports", amazon_import_batches_path %>
        <%= link_to "Tax Packet", tax_packet_path %>
        <%= link_to "TurboTax Export", turbo_tax_export_path %>
      </nav>
      <% if notice.present? %>
        <div class="flash"><%= notice %></div>
      <% end %>
      <% if alert.present? %>
        <div class="flash alert"><%= alert %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
