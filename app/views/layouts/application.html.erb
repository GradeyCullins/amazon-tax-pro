<!DOCTYPE html>
<html>
  <head>
    <title>Amazon Tax Pro</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="icon" type="image/png" href="/favicon.png">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <style>
      :root {
        --ink:#131921;
        --paper:#f3f3f3;
        --surface:#ffffff;
        --surface-soft:#f7f7f7;
        --surface-muted:#e3e6e6;
        --border:#131921;
        --primary:#ff9900;
        --primary-dark:#e47911;
        --muted:#565959;
        --shadow:7px 7px 0 var(--ink);
        --small-shadow:4px 4px 0 var(--ink);
      }

      * { box-sizing:border-box; }
      html { background:var(--paper); }
      body {
        background:
          linear-gradient(90deg, rgba(19,25,33,.045) 1px, transparent 1px),
          linear-gradient(rgba(19,25,33,.045) 1px, transparent 1px),
          var(--paper);
        background-size:34px 34px;
        color:var(--ink);
        font-family:ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-size:16px;
        font-weight:650;
        margin:0;
        overflow-x:hidden;
      }
      body::before {
        background:var(--primary);
        content:"";
        display:block;
        height:8px;
      }
      .shell { max-width:1240px; margin:0 auto; padding:24px; width:100%; }
      .nav {
        align-items:center;
        background:var(--surface);
        border:4px solid var(--border);
        box-shadow:var(--shadow);
        display:flex;
        gap:10px;
        margin-bottom:34px;
        padding:12px;
        transform:rotate(-.35deg);
        flex-wrap:wrap;
      }
      .nav a {
        background:var(--surface-soft);
        border:3px solid var(--border);
        border-radius:999px;
        color:var(--ink);
        display:inline-flex;
        font-weight:950;
        min-height:42px;
        align-items:center;
        justify-content:center;
        padding:8px 14px;
        text-decoration:none;
        transition:transform .12s ease, box-shadow .12s ease, background .12s ease;
      }
      .nav a:first-child {
        background:var(--ink);
        color:#fff;
        font-size:20px;
        padding-inline:18px;
      }
      .nav a:nth-child(2) { background:var(--surface-muted); }
      .nav a:nth-child(3) { background:var(--surface); }
      .nav a:nth-child(4) { background:var(--primary); color:var(--ink); }
      .nav a:hover, .button:hover {
        box-shadow:var(--small-shadow);
        transform:translate(-2px, -2px) rotate(-1deg);
      }
      h1 {
        color:var(--ink);
        font-family:ui-serif, Georgia, "Times New Roman", serif;
        font-size:clamp(44px, 10vw, 86px);
        font-weight:1000;
        line-height:.95;
        margin:0 0 16px;
        max-width:900px;
        overflow-wrap:anywhere;
      }
      h2 {
        font-family:ui-serif, Georgia, "Times New Roman", serif;
        font-size:clamp(25px, 4vw, 38px);
        font-weight:1000;
        line-height:.95;
        margin-bottom:14px;
      }
      p { line-height:1.45; }
      a { color:var(--primary); font-weight:950; text-decoration-thickness:3px; text-underline-offset:4px; }
      .page-header {
        align-items:flex-start;
        display:flex;
        gap:20px;
        justify-content:space-between;
        margin-bottom:24px;
      }
      .page-header .muted {
        color:var(--ink);
        font-size:15px;
        max-width:680px;
        text-transform:none;
      }
      .actions { display:flex; gap:10px; flex-wrap:wrap; }
      .grid { display:grid; gap:18px; }
      .cards { grid-template-columns: repeat(auto-fit,minmax(200px,1fr)); }
      .dashboard-main { grid-template-columns:minmax(0,2fr) minmax(260px,1fr); margin-top:18px; }
      .guide-grid { grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); margin-bottom:18px; }
      .card {
        background:var(--surface);
        border:4px solid var(--border);
        border-radius:8px;
        box-shadow:var(--shadow);
        min-width:0;
        overflow-x:auto;
        padding:18px;
      }
      .cards > .card:nth-child(4n+1) { background:var(--surface); transform:rotate(-.4deg); }
      .cards > .card:nth-child(4n+2) { background:var(--surface-soft); transform:rotate(.5deg); }
      .cards > .card:nth-child(4n+3) { background:var(--surface-muted); transform:rotate(-.2deg); }
      .cards > .card:nth-child(4n+4) { background:#f3f4f6; transform:rotate(.3deg); }
      turbo-frame.card { display:block; }
      .button {
        appearance:none;
        background:var(--primary);
        border:4px solid var(--border);
        border-radius:999px;
        box-shadow:var(--small-shadow);
        color:var(--ink);
        display:inline-flex;
        align-items:center;
        justify-content:center;
        font:inherit;
        font-weight:1000;
        min-height:46px;
        padding:9px 16px;
        text-align:center;
        text-decoration:none;
        transition:transform .12s ease, box-shadow .12s ease, background .12s ease;
      }
      .button:hover { background:var(--primary-dark); }
      .button.secondary { background:var(--surface); color:var(--ink); }
      .button.secondary:hover { background:var(--surface-muted); }
      .button.small { min-height:38px; padding:6px 12px; font-size:14px; }
      .flash {
        background:var(--surface-muted);
        border:4px solid var(--border);
        box-shadow:var(--small-shadow);
        margin-bottom:20px;
        padding:12px 14px;
        font-weight:950;
      }
      .flash.alert { background:#d1d5db; color:var(--ink); }
      .guide-card h2,
      .guide-card h3 {
        margin-top:0;
      }
      .guide-card h3 {
        font-family:ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-size:19px;
        line-height:1.1;
        margin-bottom:8px;
      }
      .guide-step {
        align-items:center;
        background:var(--ink);
        border:3px solid var(--border);
        border-radius:999px;
        color:#fff;
        display:inline-flex;
        font-family:ui-serif, Georgia, "Times New Roman", serif;
        font-size:28px;
        font-weight:1000;
        height:48px;
        justify-content:center;
        margin-bottom:12px;
        width:48px;
      }
      .guide-copy {
        color:var(--ink);
        font-size:15px;
        font-weight:750;
        line-height:1.45;
        margin:0;
      }
      .guide-list {
        display:grid;
        gap:10px;
        list-style:none;
        margin:0;
        padding:0;
      }
      .guide-list li {
        background:var(--surface-soft);
        border:3px solid var(--border);
        border-radius:6px;
        margin:0;
        padding:10px 12px;
      }
      .callout {
        background:var(--surface-muted);
        border:4px solid var(--border);
        box-shadow:var(--small-shadow);
        margin:18px 0;
        padding:14px 16px;
      }
      .callout p { margin:0; }
      .form-row { display:grid; gap:7px; margin-bottom:14px; max-width:520px; width:100%; }
      .inline-form { display:flex; gap:10px; align-items:center; flex-wrap:wrap; }
      label { font-weight:950; }
      input, select {
        background:var(--surface);
        border:3px solid var(--border);
        border-radius:6px;
        box-shadow:3px 3px 0 rgba(17,24,39,.2);
        color:var(--ink);
        font:inherit;
        max-width:100%;
        min-height:42px;
        padding:8px 10px;
      }
      input:focus, select:focus {
        outline:4px solid var(--primary);
        outline-offset:2px;
      }
      input[type="file"] { width:100%; }
      .muted {
        color:var(--muted);
        font-size:12px;
        font-weight:950;
        letter-spacing:0;
        text-transform:uppercase;
      }
      .value {
        color:var(--primary);
        font-family:ui-serif, Georgia, "Times New Roman", serif;
        font-size:clamp(28px, 7vw, 42px);
        font-weight:1000;
        line-height:.95;
        margin-top:8px;
        overflow-wrap:anywhere;
      }
      .tax-packet-cards .value {
        font-size:clamp(20px, 4.2vw, 30px);
        margin-top:auto;
        overflow-wrap:normal;
        padding-top:14px;
        white-space:nowrap;
      }
      .tax-packet-cards > .card {
        display:flex;
        flex-direction:column;
        min-height:112px;
      }
      .tight {
        border-collapse:separate;
        border-spacing:0;
        width:100%;
        font-size:14px;
      }
      .tight td,.tight th {
        border-bottom:3px solid var(--ink);
        padding:12px 10px;
        text-align:left;
        vertical-align:top;
      }
      .tight th {
        background:var(--ink);
        color:#fff;
        font-weight:1000;
      }
      .tight tr:nth-child(even) td { background:var(--surface-soft); }
      .tight tr:hover td { background:var(--surface-muted); }
      .tight.schedule-c-table { min-width:0; table-layout:fixed; }
      .schedule-c-table th:first-child,.schedule-c-table td:first-child { width:58px; }
      .schedule-c-table th:last-child,.schedule-c-table td:last-child { text-align:right; white-space:nowrap; width:112px; }
      .schedule-c-table .reference-line td { background:var(--surface-soft); }
      .schedule-c-table .reference-line td:not(:first-child) { font-weight:1000; }
      .bars { display:grid; gap:12px; }
      .bar { align-items:center; display:grid; gap:8px; grid-template-columns:minmax(110px, 1fr) minmax(90px, 2fr); }
      .bar span:first-child { min-width:0; overflow-wrap:anywhere; }
      .bar span:last-child {
        background:linear-gradient(90deg, var(--ink), var(--surface-muted));
        border:3px solid var(--border);
        display:inline-block;
        height:18px;
        min-width:18px;
      }
      .nav-account { align-items:center; display:flex; gap:10px; margin-left:auto; flex-wrap:wrap; }
      .nav-account form { margin:0; }
      .nav-account .button { min-height:42px; padding:6px 14px; }
      .nav-email { font-size:14px; font-weight:950; overflow-wrap:anywhere; }
      .auth-card { margin:36px auto 0; max-width:520px; transform:rotate(-.3deg); }
      .auth-card h1 { font-size:clamp(40px, 8vw, 64px); }
      .auth-card .form-row input { width:100%; }
      .pill {
        background:var(--surface-muted);
        border:3px solid var(--border);
        border-radius:999px;
        display:inline-block;
        font-size:13px;
        font-weight:1000;
        padding:3px 10px;
        white-space:nowrap;
      }
      .pill.good { background:#c7f0d0; }
      .pill.warn { background:var(--primary); }
      .pill.bad { background:#f4b4b4; }
      .review-sync { margin-bottom:12px; padding:0; }
      .review-sync > summary { align-items:center; cursor:pointer; display:flex; flex-wrap:wrap; gap:10px; list-style:none; padding:12px 16px; }
      .review-sync > summary::-webkit-details-marker { display:none; }
      .review-sync > summary:focus-visible { outline:4px solid var(--primary); outline-offset:2px; }
      .review-sync[open] > summary .review-chevron { transform:rotate(90deg); }
      .review-sync-source { color:var(--muted); font-size:12px; margin-left:auto; }
      .review-sync-detail { border-top:2px solid var(--border); color:var(--muted); font-size:13px; padding:8px 16px 12px; }
      .review-sync-detail p { margin:4px 0; }
      .review-controls { margin-bottom:12px; }
      .review-controls h2,.review-results h2 { font-size:clamp(23px, 3vw, 31px); margin:0 0 12px; }
      .review-search { align-items:end; display:flex; flex-wrap:wrap; gap:12px; }
      .review-search > div { display:grid; gap:5px; }
      .review-search-field { flex:2 1 290px; }
      .review-search-field input { width:100%; }
      .review-amount-field { flex:0 1 135px; }
      .review-amount-field input { width:100%; }
      .review-sort-field { flex:0 1 155px; }
      .review-sort-field select { width:100%; }
      .review-search label { font-size:13px; }
      .review-search .button { min-height:42px; }
      .review-search .review-search-actions { align-items:center; display:flex; flex-wrap:wrap; gap:10px; }
      .review-filter-hint { color:var(--muted); font-size:12px; font-weight:750; margin:12px 0 0; }
      .review-filter-error { background:#f4b4b4; border:2px solid var(--border); border-radius:6px; font-size:13px; margin:12px 0 0; padding:8px 10px; }
      .review-results-heading { align-items:center; display:flex; flex-wrap:wrap; gap:14px; justify-content:space-between; margin-bottom:14px; }
      .review-results-heading h2 { margin-bottom:5px; }
      .review-progress-label { margin:0 0 6px; }
      .review-status-overview { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; margin-bottom:16px; }
      .review-status-overview > div { align-items:center; background:var(--surface-soft); border:2px solid var(--border); border-radius:7px; display:flex; gap:8px; justify-content:space-between; padding:8px 12px; }
      .review-status-overview > div:first-child { background:#ffe2b3; }
      .review-status-overview span { font-size:12px; }
      .review-status-overview strong { font-size:19px; }
      .review-list { display:grid; gap:8px; }
      .review-order { background:var(--surface-soft); border:2px solid var(--border); border-radius:7px; }
      .review-order[open] { background:var(--surface); }
      .review-order > summary { align-items:center; cursor:pointer; display:grid; gap:12px; grid-template-columns:16px minmax(170px,1fr) minmax(160px,1fr) 92px; list-style:none; padding:10px 12px; }
      .review-order > summary::-webkit-details-marker { display:none; }
      .review-order > summary:hover { background:var(--surface-muted); }
      .review-order > summary:focus-visible { outline:4px solid var(--primary); outline-offset:2px; }
      .review-order[open] > summary .review-chevron { transform:rotate(90deg); }
      .review-order-categories { color:var(--muted); display:flex; flex-wrap:wrap; font-size:12px; gap:4px 10px; overflow-wrap:anywhere; }
      .review-order-categories em { background:#ffe2b3; border-radius:4px; color:var(--ink); font-style:normal; font-weight:900; padding:1px 5px; }
      .review-order > summary .pill { font-size:11px; text-align:center; }
      .review-order-rows { border-top:2px solid var(--border); display:grid; gap:6px; padding:10px; }
      .review-row { border:2px solid var(--border); border-radius:7px; background:var(--surface-soft); }
      .review-row[open] { background:var(--surface); }
      .review-row summary { align-items:center; cursor:pointer; display:grid; gap:12px; grid-template-columns:16px minmax(160px,1fr) minmax(130px,180px) minmax(90px,125px) 92px; list-style:none; padding:9px 12px; }
      .review-row summary::-webkit-details-marker { display:none; }
      .review-row summary:hover { background:var(--surface-muted); }
      .review-row summary:focus-visible { outline:4px solid var(--primary); outline-offset:2px; }
      .review-chevron { font-size:19px; line-height:1; transition:transform .12s ease; }
      .review-row[open] .review-chevron { transform:rotate(90deg); }
      .review-row-main { display:grid; gap:2px; min-width:0; overflow-wrap:anywhere; }
      .review-row-main strong { font-size:14px; }
      .review-row-main small { color:var(--muted); font-size:11px; font-weight:800; }
      .review-row-category { font-size:13px; }
      .review-row-amount { font-size:14px; text-align:right; white-space:nowrap; }
      .review-row .pill { font-size:11px; text-align:center; }
      .review-row-detail { border-top:2px solid var(--border); padding:10px 14px 14px 40px; }
      .review-row-detail p { font-size:13px; margin:0 0 7px; overflow-wrap:anywhere; }
      .review-row-detail .inline-form { margin-top:8px; }
      .review-row-detail select { max-width:230px; }
      .review-pages { align-items:center; display:flex; flex-wrap:wrap; gap:12px; justify-content:center; margin-top:16px; }
      .review-pages span { font-size:13px; }
      .button.danger { background:#f4b4b4; color:var(--ink); }
      .button.danger:hover { background:#ee8f8f; }
      .connect-card { border-color:var(--ink); background:linear-gradient(135deg, var(--surface) 0 70%, #ffe2b3 70% 100%); margin-bottom:18px; }
      .connect-card h2 { margin-top:0; }
      .connect-meta { display:flex; flex-wrap:wrap; gap:10px; margin:10px 0 14px; }
      ul, ol { padding-left:24px; }
      li { margin-bottom:8px; }

      @media (max-width: 720px) {
        .review-status-overview { gap:6px; }
        .review-status-overview > div { align-items:flex-start; flex-direction:column; padding:7px; }
        .review-status-overview span { font-size:11px; }
        .review-status-overview strong { font-size:16px; }
        .review-order > summary { grid-template-columns:16px minmax(0,1fr) auto; gap:7px; }
        .review-order-categories { grid-column:2 / 4; }
        .review-order > summary .pill { grid-column:3; grid-row:1; }
        .review-row summary { grid-template-columns:16px minmax(0,1fr) auto; gap:7px; }
        .review-row-category { grid-column:2; }
        .review-row-amount { grid-column:3; grid-row:1; }
        .review-row .pill { grid-column:3; grid-row:2; }
        .review-row-detail { padding-left:12px; }
        .shell { padding:16px; }
        .nav { align-items:stretch; gap:8px; transform:none; }
        .nav a { flex:1 1 150px; padding:8px; text-align:center; }
        .page-header { display:grid; }
        .actions, .page-header > .button { width:100%; }
        .actions .button, .page-header > .button { flex:1 1 160px; }
        .dashboard-main { grid-template-columns:1fr; }
        .guide-grid { grid-template-columns:1fr; }
        .card { padding:14px; }
        .tight { min-width:640px; }
        .inline-form { align-items:stretch; }
        .inline-form select, .inline-form input, .inline-form .button { flex:1 1 140px; }
      }

      @media (max-width: 460px) {
        .cards { grid-template-columns:1fr; }
        .button { width:100%; }
      }
    </style>
  </head>

  <body>
    <main class="shell">
      <nav class="nav">
        <%= link_to "Amazon Tax Pro", root_path %>
        <% if authenticated? %>
          <%= link_to "Imports", amazon_import_batches_path %>
          <%= link_to "Tax Packet", tax_packet_path %>
          <%= link_to "TurboTax Export", turbo_tax_export_path %>
          <div class="nav-account">
            <%= link_to Current.user.email_address, user_account_path, class: "nav-email" %>
            <%= button_to "Sign out", session_path, method: :delete, class: "button secondary" %>
          </div>
        <% end %>
      </nav>
      <% if notice.present? %>
        <div class="flash"><%= notice %></div>
      <% end %>
      <% if alert.present? %>
        <div class="flash alert"><%= alert %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
