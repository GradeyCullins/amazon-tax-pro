<!DOCTYPE html>
<html>
  <head>
    <title>Amazon Tax Pro</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="icon" type="image/png" href="/favicon.png">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <style>
      :root {
        --ink:#131921;
        --text:#0f1111;
        --paper:#f3f3f3;
        --surface:#ffffff;
        --surface-soft:#f7f8f8;
        --surface-muted:#eaeded;
        --border:#d5d9d9;
        --border-strong:#888c8c;
        --primary:#ff9900;
        --primary-dark:#e47911;
        --primary-soft:#fff4e0;
        --primary-line:#f3c27a;
        --link:#007185;
        --link-hover:#c7511f;
        --good:#e6f4ea;
        --good-line:#a8d5b5;
        --good-text:#0d6b2f;
        --warn-text:#8a4b00;
        --bad:#fdecea;
        --bad-line:#f0b4ad;
        --bad-dark:#b12704;
        --bad-darker:#8f1f03;
        --muted:#565959;
        --radius:8px;
        --shadow:0 1px 2px rgba(15,17,17,.08);
      }

      * { box-sizing:border-box; }
      html { background:var(--paper); }
      body {
        background:var(--paper);
        color:var(--text);
        font-family:ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-size:15px;
        font-weight:400;
        line-height:1.5;
        margin:0;
        overflow-x:hidden;
      }
      .app-bar {
        align-items:center;
        background:var(--ink);
        color:#fff;
        display:flex;
        flex-wrap:wrap;
        gap:4px 28px;
        min-height:56px;
        padding:0 32px;
      }
      .brand { color:#fff; font-size:17px; font-weight:700; letter-spacing:-.01em; text-decoration:none; white-space:nowrap; }
      .brand:hover { color:#fff; }
      .nav { align-items:stretch; align-self:stretch; display:flex; gap:4px; }
      .nav a {
        align-items:center;
        border-bottom:3px solid transparent;
        border-top:3px solid transparent;
        color:#d5d9d9;
        display:inline-flex;
        font-weight:500;
        padding:0 12px;
        text-decoration:none;
      }
      .nav a:hover { color:#fff; }
      .nav a[aria-current="page"] { border-bottom-color:var(--primary); color:#fff; font-weight:600; }
      .nav-count {
        background:var(--primary);
        border-radius:999px;
        color:var(--ink);
        font-size:11px;
        font-weight:700;
        line-height:1;
        margin-left:6px;
        min-width:20px;
        padding:4px 6px;
        text-align:center;
      }
      .nav-account { align-items:center; display:flex; flex-wrap:wrap; gap:12px; margin-left:auto; }
      .nav-account form { margin:0; }
      .nav-email { color:#d5d9d9; font-size:14px; font-weight:500; overflow-wrap:anywhere; text-decoration:none; }
      .nav-email:hover, .nav-email[aria-current="page"] { color:#fff; text-decoration:underline; }
      .nav-account .button.secondary { background:transparent; border-color:#5a6370; color:#fff; font-size:13px; font-weight:500; min-height:32px; padding:4px 12px; }
      .nav-account .button.secondary:hover { background:#232f3e; }
      .shell { margin:0 auto; max-width:1920px; padding:28px 32px 24px; width:100%; }
      h1 {
        color:var(--text);
        font-size:28px;
        font-weight:700;
        letter-spacing:-.01em;
        line-height:1.2;
        margin:0 0 6px;
        overflow-wrap:anywhere;
      }
      h2 { font-size:19px; font-weight:700; line-height:1.3; margin:0 0 12px; }
      h3 { font-size:16px; font-weight:600; line-height:1.3; }
      p { line-height:1.5; }
      strong { font-weight:600; }
      a { color:var(--link); font-weight:500; text-decoration:underline; text-decoration-thickness:1px; text-underline-offset:2px; }
      a:hover { color:var(--link-hover); }
      a:focus-visible, .button:focus-visible, summary:focus-visible {
        outline:2px solid var(--link);
        outline-offset:2px;
      }
      code { background:var(--surface-muted); border-radius:4px; font-size:.9em; padding:1px 4px; }
      .page-header {
        align-items:flex-start;
        display:flex;
        gap:20px;
        justify-content:space-between;
        margin-bottom:20px;
      }
      .page-header .muted {
        color:var(--muted);
        font-size:15px;
        font-weight:400;
        letter-spacing:0;
        margin:0;
        max-width:760px;
        text-transform:none;
      }
      .actions { align-items:center; display:flex; flex-wrap:wrap; gap:8px; }
      .actions form { margin:0; }
      .grid { display:grid; gap:16px; }
      .cards { grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); }
      .dashboard-main { grid-template-columns:minmax(0, 2fr) minmax(300px, 1fr); margin-top:16px; }
      .guide-grid { grid-template-columns:repeat(auto-fit, minmax(230px, 1fr)); margin-bottom:16px; }
      .card {
        background:var(--surface);
        border:1px solid var(--border);
        border-radius:var(--radius);
        box-shadow:var(--shadow);
        min-width:0;
        overflow-x:auto;
        padding:20px;
      }
      .card > :first-child { margin-top:0; }
      .card > :last-child { margin-bottom:0; }
      .section { margin-top:16px; }
      .button {
        align-items:center;
        appearance:none;
        background:var(--primary);
        border:1px solid var(--primary-dark);
        border-radius:var(--radius);
        color:var(--ink);
        cursor:pointer;
        display:inline-flex;
        font:inherit;
        font-weight:600;
        justify-content:center;
        min-height:36px;
        padding:6px 14px;
        text-align:center;
        text-decoration:none;
        transition:background .12s ease, border-color .12s ease;
        white-space:nowrap;
      }
      .button:hover { background:var(--primary-dark); color:var(--ink); }
      .button.secondary { background:var(--surface); border-color:var(--border-strong); color:var(--text); }
      .button.secondary:hover { background:var(--surface-soft); }
      .button.small { font-size:13px; min-height:30px; padding:4px 10px; }
      .button.danger { background:var(--bad-dark); border-color:var(--bad-darker); color:#fff; }
      .button.danger:hover { background:var(--bad-darker); color:#fff; }
      .flash {
        background:var(--good);
        border:1px solid var(--good-line);
        border-radius:var(--radius);
        color:var(--text);
        margin-bottom:20px;
        padding:10px 14px;
      }
      .flash.alert { background:var(--bad); border-color:var(--bad-line); }
      .guide-card h2, .guide-card h3 { margin-top:0; }
      .guide-card h3 { margin-bottom:6px; }
      .guide-step {
        align-items:center;
        background:var(--primary-soft);
        border:1px solid var(--primary-line);
        border-radius:999px;
        color:var(--warn-text);
        display:inline-flex;
        font-size:14px;
        font-weight:700;
        height:30px;
        justify-content:center;
        margin-bottom:10px;
        width:30px;
      }
      .guide-copy { color:var(--text); font-size:15px; line-height:1.5; margin:0; }
      .guide-copy + form, .guide-copy + .form-row { margin-top:16px; }
      .guide-copy.section { margin-top:16px; }
      .guide-list { display:grid; gap:8px; list-style:none; margin:0; padding:0; }
      .guide-list li {
        background:var(--surface-soft);
        border:1px solid var(--border);
        border-radius:6px;
        margin:0;
        padding:10px 12px;
      }
      .callout {
        background:var(--surface-soft);
        border:1px solid var(--border);
        border-radius:var(--radius);
        margin:16px 0;
        padding:12px 14px;
      }
      .callout p { margin:0; }
      .callout.warn { background:var(--primary-soft); border-color:var(--primary-line); }
      .callout .actions { margin-top:12px; }
      .note { color:var(--muted); font-size:13px; line-height:1.5; margin:12px 0 0; }
      .build-info { color:var(--muted); font-size:12px; margin:32px 0 0; text-align:center; }
      .build-info code { background:none; padding:0; }
      .year-switcher { align-items:center; display:flex; flex-wrap:wrap; gap:8px; margin:0; }
      .tabs { display:flex; flex-wrap:wrap; gap:6px; margin-bottom:14px; }
      .tabs a {
        background:var(--surface);
        border:1px solid var(--border);
        border-radius:999px;
        color:var(--text);
        font-size:13px;
        padding:4px 12px;
        text-decoration:none;
      }
      .tabs a:hover { background:var(--surface-soft); }
      .tabs a[aria-current="page"] { background:var(--ink); border-color:var(--ink); color:#fff; }
      .tab-count { margin-left:4px; opacity:.7; }
      .filters { display:grid; gap:8px; margin-bottom:14px; }
      .filters .note { margin:0; }
      .pagination { align-items:center; display:flex; flex-wrap:wrap; gap:10px; justify-content:space-between; margin-top:14px; }
      .empty-state p { max-width:680px; }
      .empty-state .actions { margin-top:14px; }
      .row-form { flex-wrap:nowrap; }
      .review-search { align-items:end; display:flex; flex-wrap:wrap; gap:12px; }
      .review-search > div { display:grid; gap:4px; }
      .review-search > .actions { align-items:center; display:flex; gap:8px; }
      .review-search-field { flex:2 1 260px; }
      .review-search-field input { width:100%; }
      .review-amount-field { flex:0 1 130px; }
      .review-amount-field input { width:100%; }
      .row-details { margin-top:4px; }
      .row-details summary { color:var(--muted); cursor:pointer; font-size:12px; font-weight:600; }
      .row-details dl { display:grid; font-size:13px; gap:2px 10px; grid-template-columns:max-content 1fr; margin:6px 0 0; }
      .row-details dt { color:var(--muted); font-weight:600; }
      .row-details dd { margin:0; overflow-wrap:anywhere; }
      .row-form select { max-width:220px; }
      .form-row { display:grid; gap:6px; margin-bottom:14px; max-width:520px; width:100%; }
      .inline-form { align-items:center; display:flex; flex-wrap:wrap; gap:8px; }
      label { font-size:14px; font-weight:600; }
      input, select {
        background:var(--surface);
        border:1px solid var(--border-strong);
        border-radius:6px;
        box-shadow:inset 0 1px 2px rgba(15,17,17,.12);
        color:var(--text);
        font:inherit;
        max-width:100%;
        min-height:36px;
        padding:6px 10px;
      }
      input:focus, select:focus {
        border-color:var(--link);
        outline:2px solid var(--link);
        outline-offset:0;
      }
      input[type="file"] { box-shadow:none; width:100%; }
      .muted {
        color:var(--muted);
        font-size:12px;
        font-weight:600;
        letter-spacing:.03em;
        text-transform:uppercase;
      }
      .value {
        color:var(--text);
        font-size:clamp(22px, 3vw, 28px);
        font-variant-numeric:tabular-nums;
        font-weight:700;
        line-height:1.15;
        margin-top:6px;
        overflow-wrap:anywhere;
      }
      .tax-packet-cards > .card { display:flex; flex-direction:column; min-height:104px; }
      .tax-packet-cards .value { font-size:clamp(18px, 2.4vw, 24px); margin-top:auto; overflow-wrap:normal; padding-top:12px; white-space:nowrap; }
      .tight {
        border-collapse:separate;
        border-spacing:0;
        font-size:14px;
        width:100%;
      }
      .tight td, .tight th {
        border-bottom:1px solid var(--border);
        padding:10px 12px;
        text-align:left;
        vertical-align:top;
      }
      .tight thead th {
        background:var(--surface-soft);
        border-top:1px solid var(--border);
        color:var(--muted);
        font-size:12px;
        font-weight:600;
        letter-spacing:.03em;
        text-transform:uppercase;
      }
      .tight th[scope="row"] { font-weight:600; white-space:nowrap; }
      .tight tbody tr:last-child td, .tight tbody tr:last-child th { border-bottom:0; }
      .tight tbody tr:hover td { background:var(--surface-soft); }
      .tight.schedule-c-table { min-width:0; table-layout:fixed; }
      .schedule-c-table th:first-child, .schedule-c-table td:first-child { width:58px; }
      .schedule-c-table th:last-child, .schedule-c-table td:last-child { text-align:right; white-space:nowrap; width:112px; }
      .schedule-c-table .reference-line td { background:var(--surface-soft); }
      .schedule-c-table .reference-line td:not(:first-child) { font-weight:600; }
      .auth-card { margin:40px auto 0; max-width:440px; }
      .auth-card h1 { font-size:24px; }
      .auth-card .form-row input { width:100%; }
      .profile-grid { align-items:start; grid-template-columns:minmax(0, 1.4fr) minmax(300px, 1fr); }
      .profile-column { display:grid; gap:16px; min-width:0; }
      .profile-grid h3 { margin:16px 0 10px; }
      .profile-grid .form-row input, .profile-grid .form-row select { width:100%; }
      .form-row small { color:var(--muted); font-size:13px; line-height:1.4; }
      .pill {
        background:var(--surface-muted);
        border:1px solid var(--border);
        border-radius:999px;
        color:var(--text);
        display:inline-block;
        font-size:12px;
        font-weight:600;
        line-height:1.5;
        padding:1px 9px;
        white-space:nowrap;
      }
      .pill.good { background:var(--good); border-color:var(--good-line); color:var(--good-text); }
      .pill.warn { background:var(--primary-soft); border-color:var(--primary-line); color:var(--warn-text); }
      .pill.bad { background:var(--bad); border-color:var(--bad-line); color:var(--bad-dark); }
      .sr-only {
        border:0;
        clip:rect(0 0 0 0);
        height:1px;
        margin:-1px;
        overflow:hidden;
        padding:0;
        position:absolute;
        white-space:nowrap;
        width:1px;
      }
      .connect-card { margin-bottom:16px; }
      .connect-card > .callout:first-child { margin-top:0; }
      .connect-header { align-items:flex-start; display:flex; flex-wrap:wrap; gap:16px; justify-content:space-between; }
      .connect-header h2 { margin:0 0 8px; }
      .connect-header .actions { flex-shrink:0; }
      .connect-meta { align-items:center; display:flex; flex-wrap:wrap; gap:8px; margin:0; }
      .connect-meta .note { margin:0 0 0 4px; }
      .connect-card .guide-copy { margin-top:14px; max-width:860px; }
      .connect-footer {
        align-items:center;
        border-top:1px solid var(--border);
        display:flex;
        flex-wrap:wrap;
        gap:12px 24px;
        justify-content:space-between;
        margin-top:16px;
        padding-top:14px;
      }
      .connect-footer .note { margin:0; max-width:860px; }
      .connect-footer form { margin:0; }
      ul, ol { padding-left:24px; }
      li { margin-bottom:6px; }

      @media (max-width: 720px) {
        .app-bar { gap:0 16px; padding:8px 16px; }
        .nav { flex-basis:100%; order:3; overflow-x:auto; }
        .nav a { padding:10px 10px 7px; white-space:nowrap; }
        .shell { padding:20px 16px; }
        .page-header { display:grid; }
        .profile-grid { grid-template-columns:1fr; }
        .actions, .page-header > .button { width:100%; }
        .actions .button, .page-header > .button { flex:1 1 160px; }
        .connect-header .actions { width:100%; }
        .dashboard-main { grid-template-columns:1fr; }
        .guide-grid { grid-template-columns:1fr; }
        .card { padding:14px; }
        .tight { min-width:640px; }
        .inline-form { align-items:stretch; }
        .inline-form select, .inline-form input, .inline-form .button { flex:1 1 140px; }
        .row-form { flex-wrap:wrap; }
      }

      @media (max-width: 460px) {
        .cards { grid-template-columns:1fr; }
        .button { width:100%; }
        .nav-account .button { width:auto; }
      }
    </style>
  </head>

  <body>
    <header class="app-bar">
      <%= link_to "Amazon Tax Pro", root_path, class: "brand" %>
      <% if authenticated? %>
        <nav class="nav" aria-label="Main">
          <%= nav_link "Dashboard", root_path %>
          <%= nav_link "Review", review_path do %>
            Review
            <% if (review_count = nav_review_count).positive? %>
              <span class="nav-count"><%= review_count %><span class="sr-only"> rows need review</span></span>
            <% end %>
          <% end %>
          <%= nav_link "Tax Packet", tax_packet_path %>
          <%= nav_link "TurboTax Export", turbo_tax_export_path %>
        </nav>
        <div class="nav-account">
          <%= link_to Current.user.display_name || Current.user.email_address, user_account_path, class: "nav-email", aria: { current: ("page" if current_page?(user_account_path)) } %>
          <%= button_to "Sign out", session_path, method: :delete, class: "button secondary" %>
        </div>
      <% end %>
    </header>
    <main class="shell">
      <% if notice.present? %>
        <div class="flash"><%= notice %></div>
      <% end %>
      <% if alert.present? %>
        <div class="flash alert"><%= alert %></div>
      <% end %>
      <%= yield %>
      <footer class="build-info">Build <code><%= BuildInfo.id %></code></footer>
    </main>
  </body>
</html>
