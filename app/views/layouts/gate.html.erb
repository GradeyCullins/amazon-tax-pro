<!DOCTYPE html>
<html>
  <head>
    <title>Amazon Tax Pro · Locked</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" type="image/png" href="/favicon.png">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <style>
      :root {
        --ink:#131921;
        --text:#0f1111;
        --paper:#f3f3f3;
        --surface:#ffffff;
        --border:#d5d9d9;
        --border-strong:#888c8c;
        --primary:#ff9900;
        --primary-dark:#e47911;
        --primary-soft:#fff4e0;
        --primary-line:#f3c27a;
        --link:#007185;
        --warn-text:#8a4b00;
        --bad:#fdecea;
        --bad-line:#f0b4ad;
        --muted:#565959;
        --radius:8px;
        --shadow:0 1px 2px rgba(15,17,17,.08);
      }
      * { box-sizing:border-box; }
      html { background:var(--paper); }
      body {
        background:var(--paper);
        color:var(--text);
        font-family:ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-size:15px;
        line-height:1.5;
        margin:0;
      }
      .app-bar {
        align-items:center;
        background:var(--ink);
        color:#fff;
        display:flex;
        min-height:56px;
        padding:0 32px;
      }
      .brand { font-size:17px; font-weight:700; letter-spacing:-.01em; }
      .shell { padding:28px 32px 24px; }
      .gate-card {
        background:var(--surface);
        border:1px solid var(--border);
        border-radius:var(--radius);
        box-shadow:var(--shadow);
        margin:40px auto 0;
        max-width:440px;
        padding:20px;
      }
      .pill {
        background:var(--primary-soft);
        border:1px solid var(--primary-line);
        border-radius:999px;
        color:var(--warn-text);
        display:inline-block;
        font-size:12px;
        font-weight:600;
        padding:1px 10px;
      }
      h1 { font-size:24px; font-weight:700; line-height:1.2; margin:10px 0 6px; }
      p { margin:0 0 16px; }
      label { display:block; font-size:14px; font-weight:600; margin-bottom:6px; }
      input[type="password"] {
        background:var(--surface);
        border:1px solid var(--border-strong);
        border-radius:6px;
        box-shadow:inset 0 1px 2px rgba(15,17,17,.12);
        color:var(--text);
        font:inherit;
        min-height:36px;
        padding:6px 10px;
        width:100%;
      }
      input[type="password"]:focus { border-color:var(--link); outline:2px solid var(--link); outline-offset:0; }
      .button {
        appearance:none;
        background:var(--primary);
        border:1px solid var(--primary-dark);
        border-radius:var(--radius);
        color:var(--ink);
        cursor:pointer;
        font:inherit;
        font-weight:600;
        margin-top:14px;
        min-height:36px;
        padding:6px 14px;
        transition:background .12s ease;
      }
      .button:hover { background:var(--primary-dark); }
      .button:focus-visible { outline:2px solid var(--link); outline-offset:2px; }
      .flash {
        background:var(--bad);
        border:1px solid var(--bad-line);
        border-radius:var(--radius);
        margin-bottom:16px;
        padding:10px 14px;
      }
      .fine { color:var(--muted); font-size:13px; margin:16px 0 0; }
      .build-info { color:var(--muted); font-size:12px; margin:32px 0 0; text-align:center; }
      .build-info code { font-size:.9em; }
      @media (max-width: 720px) {
        .app-bar, .shell { padding-left:16px; padding-right:16px; }
        .gate-card { margin-top:16px; padding:16px; }
      }
    </style>
  </head>
  <body>
    <header class="app-bar">
      <span class="brand">Amazon Tax Pro</span>
    </header>
    <main class="shell">
      <div class="gate-card">
        <%= yield %>
      </div>
      <footer class="build-info">Build <code><%= BuildInfo.id %></code></footer>
    </main>
  </body>
</html>
