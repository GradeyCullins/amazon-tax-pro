<%# One year for the whole app: switching here changes it on every page. -%>
<%= form_with url: request.path, method: :get, class: "year-switcher" do |form| %>
  <%= form.label :year, "Tax year", for: "tax_year_switcher" %>
  <%= form.select :year, tax_year_options, { selected: current_tax_year }, id: "tax_year_switcher" %>
  <%= form.submit "Switch", name: nil, class: "button secondary" %>
<% end %>
