<div class="page-header">
  <div>
    <h1>Tax Packet <%= @year %></h1>
    <p class="muted">Your <%= @year %> totals from every row that counts: auto-categorized and accepted. Review with a tax professional before filing.</p>
  </div>
  <div class="actions">
    <%= render "shared/tax_year_switcher" %>
    <%= link_to "Review", review_path(year: @year), class: "button secondary" %>
    <%= link_to "TurboTax export", turbo_tax_export_path(year: @year), class: "button secondary" %>
  </div>
</div>

<% if !@year_status.rows? %>
  <div class="card empty-state">
    <h2>No <%= @year %> transactions yet</h2>
    <p class="guide-copy">Your tax packet fills in once you sync <%= @year %> from Amazon.</p>
    <div class="actions">
      <%= render "amazon_syncs/sync_action", year: @year %>
    </div>
  </div>
<% else %>
  <%= render "shared/mixed_source_warning", year_status: @year_status %>

  <% if @year_status.needs_review_count.positive? %>
    <div class="callout warn">
      <p>Not included yet: <%= pluralize(number_with_delimiter(@year_status.needs_review_count), "row") %> that need<%= "s" if @year_status.needs_review_count == 1 %> a category. <%= link_to "Review them", review_path(year: @year) %></p>
    </div>
  <% end %>

  <% if @year_status.sandbox_sample? %>
    <div class="callout"><p>These totals include Amazon sandbox sample transactions. They're for testing only.</p></div>
  <% end %>

  <div class="grid cards tax-packet-cards">
    <div class="card">
      <div class="muted">Gross receipts (sales + shipping credits)</div>
      <div class="value"><%= money(@activity.gross_receipts_cents) %></div>
    </div>
    <div class="card">
      <div class="muted">After-fee revenue</div>
      <div class="value"><%= money(@activity.revenue_cents) %></div>
    </div>
    <% AmazonImportRow::TAX_CATEGORIES.each do |category, label| %>
      <% next if category == "uncategorized" %>
      <% amount_cents = category == "cost_of_goods_sold" ? @cogs_input.cost_of_goods_sold_cents : @activity.total_cents(category) %>
      <div class="card">
        <div class="muted"><%= { "shipping" => "Shipping (net)", "cost_of_goods_sold" => "Cost of goods sold (you enter)" }.fetch(category, label) %></div>
        <div class="value"><%= money(amount_cents) %></div>
      </div>
    <% end %>
  </div>

  <p class="note">
    Expenses and withheld tax show as positive totals, and credits are netted against their category (a refunded fee lowers fees).
    After-fee revenue is gross receipts minus refunds, Amazon and FBA fees, advertising, and shipping charges. It's a planning
    figure; Schedule C reports gross receipts and each expense separately. Cost of goods sold comes from your
    <%= link_to "TurboTax export inputs", turbo_tax_export_path(year: @year) %>.
  </p>

  <div class="card section">
    <h2>Audit trail</h2>
    <% if @pagination.total_count.zero? %>
      <p class="guide-copy">No <%= @year %> rows count yet. <%= link_to "Review #{@year}", review_path(year: @year) %></p>
    <% else %>
      <table class="tight">
        <thead>
          <tr>
            <th scope="col">Date</th>
            <th scope="col">Category</th>
            <th scope="col">Description</th>
            <th scope="col">Amount</th>
            <th scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
          <% @pagination.records.each do |row| %>
            <tr>
              <td><%= row.posted_on %></td>
              <td><%= row.tax_category_name %></td>
              <td><%= row.description.presence || row.order_id || "Amazon transaction" %></td>
              <td><%= money(row.amount_cents) %></td>
              <td><%= review_pill(row.review_status) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <%= render "shared/pagination", pagination: @pagination %>
    <% end %>
  </div>
<% end %>
