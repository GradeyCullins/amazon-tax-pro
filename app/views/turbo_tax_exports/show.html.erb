<div class="page-header">
  <div>
    <h1>TurboTax Export <%= @year %></h1>
    <p class="muted">Turn your <%= @year %> rows that count into a TurboTax Desktop TXF file, plus an audit CSV for your records.</p>
  </div>
  <div class="actions">
    <%= render "shared/tax_year_switcher" %>
    <%= link_to "Review", review_path(year: @year), class: "button secondary" %>
    <%= link_to "Tax packet", tax_packet_path(year: @year), class: "button secondary" %>
  </div>
</div>

<%= render "shared/mixed_source_warning", year_status: @export.year_status %>

<% if !@export.year_status.rows? %>
  <div class="callout warn">
    <p>No <%= @year %> transactions yet. Sync <%= @year %> from Amazon first; you can still enter cost of goods sold below.</p>
    <div class="actions">
      <%= render "amazon_syncs/sync_action", year: @year %>
    </div>
  </div>
<% end %>

<div class="grid dashboard-main">
  <div class="card">
    <h2>Schedule C preview</h2>
    <table class="tight schedule-c-table">
      <thead>
        <tr>
          <th scope="col">TXF ref</th>
          <th scope="col">TurboTax line</th>
          <th scope="col">Amount</th>
        </tr>
      </thead>
      <tbody>
        <% if @export.lines.any? %>
          <tr class="reference-line">
            <td>—</td>
            <td>After-fee revenue (reference only)</td>
            <td><%= money(@export.activity.revenue_cents) %></td>
          </tr>
        <% end %>
        <% @export.lines.each do |line| %>
          <tr>
            <td><%= line.txf_ref %></td>
            <td><%= line.label %></td>
            <td><%= money(line.amount_cents) %></td>
          </tr>
        <% end %>
        <% if @export.lines.empty? %>
          <tr><td colspan="3">No <%= @year %> rows count toward Schedule C yet.</td></tr>
        <% end %>
      </tbody>
    </table>
    <% if @export.lines.any? %>
      <p class="note">After-fee revenue matches the <%= link_to "#{@year} tax packet", tax_packet_path(year: @year) %>. It's a planning figure, not a TXF line.</p>
    <% end %>
  </div>

  <div class="card">
    <h2>Readiness</h2>
    <% if @export.warnings.any? %>
      <ul>
        <% @export.warnings.each do |warning| %>
          <li><%= warning %></li>
        <% end %>
      </ul>
      <% if @export.needs_review_count.positive? %>
        <p class="guide-copy"><%= link_to "Review #{@year}", review_path(year: @year) %> to include those rows.</p>
      <% end %>
    <% else %>
      <p class="guide-copy">No export warnings for <%= @year %>.</p>
    <% end %>
    <div class="actions">
      <%= link_to "Download TXF", download_turbo_tax_export_path(year: @year), class: "button" %>
      <%= link_to "Audit CSV", download_turbo_tax_export_path(year: @year, format_type: "audit"), class: "button secondary" %>
      <%= link_to "Instructions", download_turbo_tax_export_path(year: @year, format_type: "instructions"), class: "button secondary" %>
    </div>
  </div>
</div>

<div class="card section">
  <h2>Cost of goods sold</h2>
  <p class="guide-copy">Amazon doesn't know what you paid for inventory. Enter your annual totals before you download the final TXF.</p>
  <%= form_with model: @input, url: turbo_tax_export_path(year: @year), method: :patch, local: true do |form| %>
    <%= form.hidden_field :tax_year, value: @year %>
    <div class="form-row">
      <%= form.label :business_name, "Schedule C business name" %>
      <%= form.text_field :business_name %>
    </div>
    <div class="grid cards">
      <% [
        [:beginning_inventory_dollars, "Beginning inventory"],
        [:purchases_dollars, "Purchases"],
        [:materials_dollars, "Materials and supplies"],
        [:labor_dollars, "Labor"],
        [:other_costs_dollars, "Other COGS"],
        [:ending_inventory_dollars, "Ending inventory"]
      ].each do |field, label| %>
        <div class="form-row">
          <%= form.label field, label %>
          <%= form.number_field field, value: @input.public_send(field), step: "0.01", min: "0" %>
        </div>
      <% end %>
    </div>
    <%= form.submit "Save cost of goods sold", class: "button" %>
  <% end %>
</div>

<div class="card section">
  <h2>Left out of Schedule C</h2>
  <p class="guide-copy">Transfers to your bank, marketplace-withheld sales tax, and reserves aren't income or expenses.</p>
  <table class="tight">
    <thead>
      <tr>
        <th scope="col">Date</th>
        <th scope="col">Category</th>
        <th scope="col">Description</th>
        <th scope="col">Amount</th>
      </tr>
    </thead>
    <tbody>
      <% @export.excluded_rows.first(50).each do |row| %>
        <tr>
          <td><%= row.posted_on || "Unknown" %></td>
          <td><%= row.tax_category_name %></td>
          <td><%= row.description %></td>
          <td><%= money(row.amount_cents) %></td>
        </tr>
      <% end %>
      <% if @export.excluded_rows.empty? %>
        <tr><td colspan="4">Nothing left out for <%= @year %>.</td></tr>
      <% end %>
    </tbody>
  </table>
  <% if @export.excluded_rows.size > 50 %>
    <p class="note">Showing the first 50 of <%= number_with_delimiter(@export.excluded_rows.size) %>. The audit CSV has every row.</p>
  <% end %>
</div>
